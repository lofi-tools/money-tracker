{
  "manifest_version": 3,
  "name": "Money Tracker \u00b7 Nexo capture (Brave)",
  "version": "0.1.0",
  "description": "Read Nexo savings and send an exact, provenance-labelled snapshot to your local tracker.",
  "permissions": [
    "scripting",
    "storage",
    "nativeMessaging"
  ],
  "optional_host_permissions": [
    "https://platform.nexo.com/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Set up Nexo capture",
    "default_popup": "options.html"
  },
  "options_page": "options.html",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'none'"
  },
  "key": ""
}
